# API Configuration - BE chạy ở port 8080
VITE_API_BASE_URL=http://localhost:8080

# Development Settings
VITE_APP_ENV=development

# Feature Flags
# Set to 'true' để sử dụng mock data (không cần backend)
# Set to 'false' để kết nối backend thật
VITE_ENABLE_MOCK_DATA=false

# Debug logs
VITE_ENABLE_DEBUG_LOGS=false

# Mock delay (ms) - giả lập độ trễ network
VITE_MOCK_DELAY=500
