# API Configuration - trỏ thẳng về backend đã deploy trên DigitalOcean.
# Cả nhóm dùng chung gateway + database trên server này, không cần bật docker local.
# Muốn chạy backend local: đổi lại thành http://localhost:18080 (host port của gateway local).
VITE_API_BASE_URL=http://146.190.84.136:8080

# Development Settings
VITE_APP_ENV=development

# Feature Flags
# Set to 'true' để sử dụng mock data (không cần backend)
# Set to 'false' để kết nối backend thật
VITE_ENABLE_MOCK_DATA=false

# Debug logs
VITE_ENABLE_DEBUG_LOGS=false

# Mock delay (ms) - giả lập độ trễ network
VITE_MOCK_DELAY=500
