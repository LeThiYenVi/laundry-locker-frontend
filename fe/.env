# API Configuration - domain production HTTPS (Nginx + Let's Encrypt -> gateway).
# BẮT BUỘC dùng HTTPS: web chạy trên https://admin.locker-drone.tech, nếu gọi API
# qua http://IP sẽ bị trình duyệt chặn (Mixed Content).
# Muốn chạy backend local: đổi thành http://localhost:18080 (host port gateway local).
VITE_API_BASE_URL=https://api.locker-drone.tech
# Chạy backend local thì đổi thành: http://localhost:18080

# Development Settings
VITE_APP_ENV=development

# Feature Flags
# Set to 'true' để sử dụng mock data (không cần backend)
# Set to 'false' để kết nối backend thật
VITE_ENABLE_MOCK_DATA=false

# Debug logs
VITE_ENABLE_DEBUG_LOGS=false

# Mock delay (ms) - giả lập độ trễ network
VITE_MOCK_DELAY=500
